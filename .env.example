# API Gateway
CORS_ORIGINS=http://localhost:5173

# Postgres (used by docker-compose + services)
POSTGRES_USER=foodie_admin
POSTGRES_PASSWORD=change-me-in-your-local-.env

# User Service Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/foodie_users
SPRING_DATASOURCE_USERNAME=foodie_admin
SPRING_DATASOURCE_PASSWORD=change-me-in-your-local-.env

# JWT Secret (Base64-encoded, min 256-bit key) - generate your own, never commit real one
JWT_SECRET=bXlTZWNyZXRLZXlGb3JGb29kaWVFeHByZXNzMjAyNSEhISEh

# MongoDB
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/foodiedb

# Razorpay (get test keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_DEMO_MODE=true

# Frontend
VITE_API_URL=http://localhost:8080/api
